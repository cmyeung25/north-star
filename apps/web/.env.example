# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred publishable key variable for this repo
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backward-compatible fallback names (optional if using the variable above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: enable debug route in production (default is disabled)
# NEXT_PUBLIC_ENABLE_DEBUG=false

# Development-only Playwright auth bootstrap.
# Uses a dedicated non-human Supabase account and keeps normal auth/middleware behavior unchanged.
# E2E_AUTH_BOOTSTRAP=1
# E2E_AUTH_SECRET=replace-with-a-long-random-string
# E2E_AUTH_EMAIL=e2e@example.com
# E2E_AUTH_PASSWORD=replace-with-the-dedicated-account-password

# Vercel reminder:
# Set the same env vars for Development, Preview, and Production, then redeploy.
